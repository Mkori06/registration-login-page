    {
      "name": "03. Security & Boundary Point Testing",
      "item": [
        {
          "name": "01. SQL Injection Bypass Attempt (Negative Test Point)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SQL injection fails with 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('No SQL error leakage in response body', function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('SQLSTATE');",
                  "    pm.expect(text).to.not.include('syntax error');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"' OR '1'='1' --\",\n  \"password\": \"' OR '1'='1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login.php",
              "host": ["{{base_url}}"],
              "path": ["api", "login.php"]
            },
            "description": "Security test point: Prepared statements prevent SQL injection and reject payload with 401 Unauthorized."
          }
        },
        {
          "name": "02. XSS Payload Injection (Security Test Point)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Response might be 201 or 422 depending on regex validation for username",
                  "pm.test('Username regex rejects dangerous script tags', function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"<script>alert('xss')</script>\",\n  \"username\": \"<script>alert(1)</script>\",\n  \"email\": \"xss@test.com\",\n  \"password\": \"SecretPass123!\",\n  \"confirm_password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register.php",
              "host": ["{{base_url}}"],
              "path": ["api", "register.php"]
            },
            "description": "Security test point: Attempts XSS injection. Strict username validation blocks illegal characters."
          }
        },
        {
          "name": "03. Boundary Test - Password Length < 8 (Boundary Test Point)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Fails on password boundary (< 8 chars)', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.errors.password).to.include('at least 8 characters');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Boundary User\",\n  \"username\": \"boundary_user\",\n  \"email\": \"boundary@test.com\",\n  \"password\": \"1234567\",\n  \"confirm_password\": \"1234567\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register.php",
              "host": ["{{base_url}}"],
              "path": ["api", "register.php"]
            },
            "description": "Boundary test point: Exact 7-character password (threshold is 8) triggers 422 error."
          }
