        {
          "name": "01. Register - Success (Positive Test Point)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique timestamp for username & email to ensure repeatability",
                  "const rand = Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('test_username', 'user_' + rand);",
                  "pm.collectionVariables.set('test_email', 'user_' + rand + '@example.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains success status and user data', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('success');",
                  "    pm.expect(res.data).to.have.property('id');",
                  "    pm.expect(res.data.username).to.eql(pm.collectionVariables.get('test_username'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman QA Tester\",\n  \"username\": \"{{test_username}}\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"confirm_password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register.php",
              "host": ["{{base_url}}"],
              "path": ["api", "register.php"]
            },
            "description": "Positive test point: Registers a brand new user. Automatically generates unique username/email before request."
          }
        },
